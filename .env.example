# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# TRUST_PROXY: number of reverse-proxy hops in front of the server (Cloud Run/Render = 1, local = 0).
TRUST_PROXY=1

# Sanad Assistant (سند) Admin Bridge & Public AI Support Widget
SANAD_API_URL=
SANAD_BRIDGE_KEY=
SANAD_WEBHOOK_SECRET=

# Firestore Admin Access for /api/sanad/* routes (provide either Service Account JSON or Firebase Admin credentials)
FIREBASE_SERVICE_ACCOUNT_JSON=
MARKET_FIREBASE_ADMIN_EMAIL=
MARKET_FIREBASE_ADMIN_PASSWORD=
